#!/bin/sh
# Two gates, both of which exist because a rule written down was not enough.
#
# * check-private.py -- private data must not enter the history. Real paths
#   leaked several times while the rule lived only in CLAUDE.md.
# * check-metrics.py -- a new long function, deep nest, long parameter list or
#   duplicated block has to be declared in tools/cq-baseline.txt with its
#   reason. Written after a duplicate went in and was noticed only later, by a
#   trend measurement taken after the push.
#
# Either script is skipped when it is not installed, so a project can take one
# gate and not the other. Enable the hooks with:
#   git config core.hooksPath .githooks   (install.sh --hooks does this)
#
# This file is a copy. The original, and the install.sh that placed and
# updates it, live in https://github.com/jam7/ai-dev-gates
#
# Nothing project-specific belongs in this file. What each project measures
# lives in tools/gate.conf, which install.sh creates and never overwrites, so
# that updating the hooks cannot silently reset it.

root=$(git rev-parse --show-toplevel)
status=0

ext=""           # extensions to measure; empty means every language
scope=""         # directories to measure; empty means the repository
extra_checks=""  # anything else this project wants run before a commit
private_doc=""   # project document to point at when the private gate fires
private_args=""  # extra check-private.py options (scopes, denylist, allow)
refs_args=""     # extra check-refs.py options (scope, allow)
trace_args=""    # trace-matrix arguments; empty leaves the trace gate off
text_scope=""    # prose patterns for textlint; empty leaves the text gate off
text_scope_en="" # English prose patterns; empty leaves the English pair off
text_config_en="" # its config; empty means tools/textlint/textlintrc.en.yml
embedded_repos="" # gitlinks this project keeps on purpose (space separated)
[ -f "$root/tools/gate.conf" ] && . "$root/tools/gate.conf"

# `git add -A` silently stages a gitlink (mode 160000) for any repository
# nested in the tree -- a private notes/ repo, typically. Measured at three
# times in one day on a real project, and the stray line survives review.
for link in $(git diff --cached --raw | awk -F'\t' '$1 ~ / 160000 / { print $2 }'); do
    case " $embedded_repos " in
        *" $link "*) ;;
        *)
            status=1
            echo "error: '$link' is staged as a gitlink (an embedded repository)." >&2
            echo "If this is an accident (git add -A does it silently), remove it:" >&2
            echo "  git rm -f --cached $link" >&2
            echo "If this project tracks it on purpose, declare it in" >&2
            echo "tools/gate.conf: embedded_repos=\"$link\"" >&2
            ;;
    esac
done

# Whether anything in this commit is in a language the structure check covers.
staged_has_code() {
    [ -z "$ext" ] && return 0
    pattern=$(printf '%s' "$ext" | sed 's/\./\\./g; s/,/$|/g; s/$/$/')
    git diff --cached --name-only --diff-filter=ACM | grep -qE "$pattern"
}

if [ -f "$root/tools/check-private.py" ]; then
    # set -f: $private_args is split into words on purpose, and a regex
    # argument like [A-Z] must not be glob-expanded against the filesystem.
    set -f
    if ! python3 "$root/tools/check-private.py" --staged $private_args; then
        status=1
        [ -n "$private_doc" ] && echo "see $private_doc" >&2
    fi
    set +f
fi

if [ -f "$root/tools/check-refs.py" ]; then
    set -f
    python3 "$root/tools/check-refs.py" --staged $refs_args || status=1
    set +f
fi

if [ -f "$root/tools/check-trace.py" ] && [ -n "$trace_args" ]; then
    set -f
    python3 "$root/tools/check-trace.py" --gate $trace_args || status=1
    set +f
fi

if [ -f "$root/tools/check-metrics.py" ] && staged_has_code; then
    args=""
    for d in $scope; do args="$args --scope $d"; done
    [ -n "$ext" ] && args="$args --ext $ext"
    # Measures the working tree rather than the index. Not the same thing when
    # a change is half-staged, but it is the code that will be there after the
    # commit, which is what the reason in the baseline has to be true of.
    python3 "$root/tools/check-metrics.py" $args || status=1
fi

# The one check that needs a runtime outside this repository. It skips with a
# notice where textlint is not installed, so the gate is weaker on some
# machines -- acceptable only because it checks writing quality. Nothing
# protective belongs here; see the README on the two portability tiers.
#
# Two scope/config pairs, because one configuration cannot serve two
# languages: the Japanese sentence limit counts characters and floods
# ordinary English, and textlint has no `overrides` to switch rules per
# file. A file matching both scopes is checked by both.
run_text_check() { # $1 = scope regexes, $2 = config path ("" = the default)
    [ -z "$1" ] && return 0
    set -f
    args=""
    for re in $1; do args="$args --scope $re"; done
    [ -n "$2" ] && args="--config $2 $args"
    python3 "$root/tools/check-text.py" --staged $args
    rc=$?
    set +f
    return "$rc"
}

if [ -f "$root/tools/check-text.py" ]; then
    run_text_check "$text_scope" "" || status=1
    run_text_check "$text_scope_en" \
        "${text_config_en:-tools/textlint/textlintrc.en.yml}" || status=1
fi

if [ -n "$extra_checks" ] && staged_has_code; then
    ( cd "$root" && eval "$extra_checks" ) || status=1
fi

exit "$status"
