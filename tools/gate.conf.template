# What the commit gate measures in this project. Sourced by the hooks in
# .githooks/, which come from https://github.com/jam7/ai-dev-gates
#
# This file is yours: install.sh (in that repository) creates it when it is
# missing and never replaces it, so updating the hooks cannot reset what you
# configured here. Shell syntax, since the hooks source it -- assignments
# only, no commands.

# Extensions the structure check measures, comma separated. Empty measures
# every language cq-metrics.py knows. Narrowing it to the production language
# keeps a docs-only commit instant.
ext=""

# Directories it measures, space separated. Empty measures the whole
# repository, which is usually worth narrowing: generated trees, vendored
# code and deliberately awkward test fixtures all drown the signal.
scope=""

# Anything else to run before a commit, as a shell command, from the
# repository root. It runs only when the commit touches a file matching ext.
# A non-zero exit blocks the commit, the same as the checks above.
#
#   extra_checks="python3 tests/run.py"
extra_checks=""

# A document of this project's, shown as "see <doc>" when the private-data
# gate blocks a commit or a push: what counts as private here, and how to
# recover when something slipped in. Empty shows nothing.
#
#   private_doc="docs/private-data.md"
private_doc=""

# Extra options for check-private.py, appended to both the pre-commit and
# pre-push runs: --scan-scope / --data-scope / --denylist / --vocabulary /
# --allow. Split on whitespace, so a regex argument must not contain spaces.
#
#   private_args="--denylist ../notes/private-patterns.txt --scan-scope \.(dart|md|ya?ml|sh|txt)$"
private_args=""

# Extra options for check-refs.py (no commit hashes in tracking documents),
# appended to the pre-commit run: --scope, --allow. Same whitespace rule as
# private_args.
refs_args=""

# Arguments for the trace-matrix commit gate (spec-dev documents vs code and
# tests). Empty leaves this gate off. When set, any commit touching the named
# paths re-checks the whole matrix -- the invariant is relational, so a
# partial check would miss exactly what the last one missed -- and the
# commit that breaks it is the one that gets told. Enable only once the
# matrix is currently green (fix or retire the breakage first).
#
#   trace_args="--code lib --code test docs/"
trace_args=""

# What textlint reads, as space-separated regexes matched against staged
# paths. Empty leaves the text gate off. This is the one check that needs a
# runtime outside the repository (Node and textlint): where textlint is not
# installed it prints a notice and passes, so the gate is WEAKER ON SOME
# MACHINES. That is acceptable for writing quality and not for anything
# protective -- private data and dead references stay in the checks above,
# which are standard-library Python and cannot be skipped.
#
# Needs tools/textlint/textlintrc.yml; with it missing the commit fails,
# deliberately (a configured check that quietly does nothing is worse).
#
#   text_scope="\.md$"
text_scope=""

# The same, for ENGLISH prose. A second pair exists because one textlint
# configuration cannot serve two languages: the Japanese sentence limit
# counts characters and floods ordinary English (measured: 27 of 31
# findings on one project came from its two English documents, none a
# writing fault), and textlint has no `overrides` to switch rules per
# file. Point text_scope at the Japanese documents and text_scope_en at
# the English ones; a file matching both is checked by both. The English
# configuration defaults to tools/textlint/textlintrc.en.yml (created
# from its .template.yml, same contract as the Japanese one).
#
#   text_scope="^(?!README\.md$).*\.md$"
#   text_scope_en="^README\.md$"
text_scope_en=""
text_config_en=""

# Embedded repositories this project tracks as gitlinks on purpose
# (submodule-style commit pointers), space separated. Any other staged
# gitlink -- the `git add -A` accident with a nested private repo --
# blocks the commit.
#
#   embedded_repos="dart_smb2"
embedded_repos=""
